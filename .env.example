GW_ADMIN_SECRET=change-me-long-random
GW_APP_SECRET=change-me-too
# Optional: bring your own key (openssl rand -base64 32 | docker run --rm -i ghcr.io/dovber... just generate)
# GW_FERNET_KEY=
# GW_ON_LIMIT=queue

# Optional Local Bot API companion (docker compose --profile local-botapi):
# GW_API_ID=
# GW_API_HASH=
# GW_UPSTREAM=https://api.telegram.org
# GW_UPSTREAM_FALLBACK=http://telegram-bot-api:8081
# GW_UPSTREAM_FAILOVER=auto
# GW_UPSTREAM_KIND=auto
# GW_ENV_DETECT=auto
# GW_UPSTREAM_CA_FILE=   # extra PEM CAs only — never skip-verify
# GW_PATH_PREFIX=/tgapi  # or "none" for bare /botTOKEN/…
# GW_MAX_MULTIPART_MB=64
# GW_UPSTREAM_TIMEOUT_S=60
