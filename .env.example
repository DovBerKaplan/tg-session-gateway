GW_ADMIN_SECRET=change-me-long-random
GW_APP_SECRET=change-me-too
# Optional: bring your own key (openssl rand -base64 32 | docker run --rm -i ghcr.io/dovber... just generate)
# GW_FERNET_KEY=
# GW_ON_LIMIT=queue
# MTProto plane: keep the shared GW_APP_SECRET working as a full-access
# caller while consumers migrate to per-client tokens (POST /v1/admin/clients).
# Set to off to require a tggc_ client token on every consumer call.
# GW_LEGACY_APP_SECRET=on
